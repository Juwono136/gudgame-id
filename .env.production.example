# =============================================================================
# TandingBase — PRODUCTION environment template
#
# Store each value as a GitHub Actions secret (Settings → Secrets → Actions).
# See docs/DEPLOYMENT_GCP.md §5 for the full secret list.
#
# Validate locally before adding secrets:
#   set -a && source .env.production && set +a
#   STRICT_PRODUCTION_ENV=true npm run validate:env
#
# DATABASE_URL / REDIS_URL / STORAGE_ENDPOINT for Docker on VPS use host.docker.internal
# (docker-compose sets extra_hosts: host-gateway).
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://tandingbase.portproject.my.id
NEXT_PUBLIC_SITE_URL=https://tandingbase.portproject.my.id

# --- Database (PostgreSQL on host) ---
DATABASE_URL=postgresql://tandingbase:CHANGE_ME@host.docker.internal:5432/tandingbase_db

# --- Redis (on host, password required) ---
REDIS_URL=redis://:CHANGE_ME@host.docker.internal:6379

# --- Auth ---
BETTER_AUTH_SECRET=CHANGE_ME_min_32_random_characters_long
BETTER_AUTH_URL=https://tandingbase.portproject.my.id
AUTH_LOCKOUT_ENABLED=true

# --- Bootstrap super admin (store as GitHub Secrets — no quotes in the UI) ---
# BOOTSTRAP_ADMIN_EMAIL=you@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_min_8_chars
# BOOTSTRAP_ADMIN_NAME=Your Name

# --- Firebase (Google sign-in) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- SeaweedFS (nginx gateway on host :8333) ---
STORAGE_ALLOW_LOCALHOST=true
STORAGE_AUTH_MODE=nginx-basic
STORAGE_ENDPOINT=http://host.docker.internal:8333
STORAGE_BUCKET=tandingbase
STORAGE_REGION=us-east-1
USERNAME_STORAGE=admin
PASSWORD_STORAGE=CHANGE_ME

# --- Xendit ---
# Testing on public deploy: XENDIT_STAGING_MODE=true + xnd_development_…
# Go-live: XENDIT_STAGING_MODE=false + xnd_production_…
XENDIT_STAGING_MODE=true
XENDIT_SECRET_KEY=xnd_development_CHANGE_ME
XENDIT_WEBHOOK_TOKEN=CHANGE_ME_long_random_webhook_token
XENDIT_XENPLATFORM_ENABLED=true

# --- Google Maps ---
GOOGLE_MAPS_API_KEY=

# --- Ops ---
HEALTH_CHECK_TOKEN=CHANGE_ME_long_random_health_token
# Protects /api/cron/host-payouts — used by payout-cron sidecar in docker-compose
CRON_SECRET=CHANGE_ME_long_random_cron_secret_min_16
LOG_LEVEL=info
STRICT_PRODUCTION_ENV=true

# --- Wiki scrape allowlist (optional) ---
# WIKI_SCRAPE_ALLOWED_HOSTS=padeltop.id,www.padeltop.id

# --- CI/CD only (GitHub Secrets, not runtime app env) ---
# DOCKER_USERNAME=yourdockerhubuser
# DOCKER_PASSWORD=dockerhub_access_token
# TUNNEL_NAME=tunnel

