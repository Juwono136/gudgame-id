# MAIN CONFIG — production template (copy values into GitHub Secrets / VPS env)
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://gudgame.id"
NEXT_PUBLIC_SITE_URL="https://gudgame.id"

# Database — Docker DNS hostname `postgres` on network `tunnel`
DATABASE_URL="postgres://USER:PASSWORD@postgres:5432/gudgame_db"
DATABASE_POOL_MAX="20"

# Redis — Docker DNS hostname `redis`
REDIS_URL="redis://:PASSWORD@redis:6379"

# Better-Auth
BETTER_AUTH_SECRET="generate_a_long_random_secret_at_least_32_chars"
BETTER_AUTH_URL="https://gudgame.id"
AUTH_LOCKOUT_ENABLED="true"

# Firebase (client + admin)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@gudgame.id"
SMTP_REPLY_TO=""
SMTP_FROM_NAME="Gud Game"

# SeaweedFS via nginx storage_gateway
STORAGE_ALLOW_LOCALHOST="true"
STORAGE_AUTH_MODE="nginx-basic"
STORAGE_ENDPOINT="http://storage_gateway:8333"
NEXT_PUBLIC_STORAGE_URL="https://storage.gudgame.id"
STORAGE_BUCKET="gudgame"
STORAGE_REGION="us-east-1"
USERNAME_STORAGE="admin"
PASSWORD_STORAGE=""

# Xendit / ops
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
XENDIT_XENPLATFORM_ENABLED="true"
STRICT_PRODUCTION_ENV="true"
XENDIT_STAGING_MODE="true"
CRON_SECRET=""
LOG_LEVEL="info"
HEALTH_CHECK_TOKEN=""
WIKI_SCRAPE_ALLOWED_HOSTS=""
GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_EMBED_API_ENABLED="false"

BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""

# Infra (docker-compose)
DOMAIN_WEB="gudgame.id"
TUNNEL_NAME="tunnel"
POSTGRESQL_USERNAME="zaka_user"
POSTGRESQL_PASSWORD=""
POSTGRESQL_DATABASE="tanding_db"
REDIS_PASSWORD=""
PGADMIN_EMAIL=""
PGADMIN_PASSWORD=""
DOCKER_USERNAME=""
DOCKER_PASSWORD=""
