# MAIN CONFIG
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Database Config
DATABASE_URL="postgres://courtadmin:supersecretpassword@localhost:5432/courtpedia_db"
# Optional pool size per Node process (default: 20 in production, 5 in development)
# DATABASE_POOL_MAX="20"

# Redis Config
REDIS_URL="redis://127.0.0.1:6379"
REDIS_PASSWORD="your_redis_password"

# Better-Auth Config
BETTER_AUTH_SECRET="select_a_very_long_and_safe_origin_string"
BETTER_AUTH_URL="http://localhost:3000"
AUTH_LOCKOUT_ENABLED="true"

# Firebase Config (Untuk Google Login)
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="courtpedia-auth.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="courtpedia-auth"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="court-pedia.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef123456"

FIREBASE_PROJECT_ID="courtpedia-auth"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email@gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"

# Nodemailer — Gmail SMTP (use App Password with 2FA, not your login password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="official.courtpedia@gmail.com"
SMTP_PASS="your_16_char_gmail_app_password"

# Object Storage (SeaweedFS filer via nginx gateway on WSL Docker)
# Server uploads use STORAGE_ENDPOINT + USERNAME_STORAGE/PASSWORD_STORAGE (nginx basic auth).
# Profile images are served to browsers via /api/media/* — do NOT point <img> at nginx directly.
STORAGE_AUTH_MODE="nginx-basic"
STORAGE_ENDPOINT="http://127.0.0.1:8333"
STORAGE_BUCKET="court-pedia"
STORAGE_REGION="us-east-1"
USERNAME_STORAGE="admin"
PASSWORD_STORAGE="your_storage_password"
# Optional legacy — not used for browser image URLs after media proxy
# NEXT_PUBLIC_STORAGE_URL="http://localhost:8333"
# For direct filer S3 API without nginx basic auth, set STORAGE_AUTH_MODE=s3 and point STORAGE_ENDPOINT to filer port

# Wiki gear import — comma-separated HTTPS hosts allowed for catalog scrape (SSRF-safe allowlist)
# WIKI_SCRAPE_ALLOWED_HOSTS="padeltop.id,www.padeltop.id,padelful.com,www.padelful.com,padelracket.id,www.padelracket.id,decathlon.co.id,www.decathlon.co.id"

# Xendit — tournament registration payments (Test keys for development)
# Dashboard: Developers → API Keys (Secret) + Webhooks (callback token)
XENDIT_SECRET_KEY="xnd_development_your_test_secret_key"
XENDIT_WEBHOOK_TOKEN="generate_a_long_random_string_for_webhook_verification"
# XenPlatform split payouts to host sub-accounts (set false to disable split routing)
XENDIT_XENPLATFORM_ENABLED="true"

# Venue search uses OpenStreetMap (Photon + Nominatim) — no API key required.
# Venue search: Google Places API (New) is primary when GOOGLE_MAPS_API_KEY is set.
# Automatically falls back to OpenStreetMap (Photon/Nominatim) on errors or quota limits.
# GOOGLE_MAPS_API_KEY="your_server_restricted_key"
# GOOGLE_MAPS_EMBED_API_ENABLED="false"
# Optional Nominatim User-Agent (OSM fallback):
# NOMINATIM_USER_AGENT="Gud Game/1.0 (contact: you@example.com)"

# Logging (optional: debug | info | warn | error)
LOG_LEVEL="debug"

# Production: protect /api/health with header X-Health-Token or Authorization: Bearer <token>
# HEALTH_CHECK_TOKEN="generate_a_long_random_string"

# Scheduled host bank payouts — protect /api/cron/host-payouts (min 16 chars)
# Used by payout-cron sidecar in docker-compose on VPS deploy
# CRON_SECRET="generate_a_long_random_string"

# Production single-VM deploy (SeaweedFS on localhost) — see docs/DEPLOYMENT_GCP.md
# STORAGE_ALLOW_LOCALHOST="true"

# Full production template: copy .env.production.example → server /opt/gudgame/.env