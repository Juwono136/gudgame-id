# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep example templates in repo)
.env
.env.*
!.env.example
!.env.production.example
.env.deploy

# SeaweedFS nginx basic-auth (generated on deploy from secrets)
ops/storage/.htpasswd
!ops/storage/.htpasswd.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
