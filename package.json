{
  "name": "gud-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/clean-dev-cache.mjs && node scripts/dev.mjs --clean",
    "dev:webpack": "node scripts/clean-dev-cache.mjs && next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:env": "tsx scripts/validate-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:prod": "drizzle-kit push --force",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "tsx scripts/run-db-migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:seed:double-stage": "node --conditions=react-server --import tsx scripts/seed-double-stage-32.ts",
    "db:seed:double-stage:purge": "node --conditions=react-server --import tsx scripts/purge-double-stage-32.ts",
    "db:seed:fixtures": "node --conditions=react-server --import tsx scripts/seed-tournament-fixtures.ts",
    "db:seed:fixtures:purge": "node --conditions=react-server --import tsx scripts/purge-tournament-fixtures.ts",
    "db:bootstrap-admin": "tsx scripts/bootstrap-admin-user.ts",
    "db:migrate-host-role": "tsx scripts/migrate-host-role.ts",
    "db:promote-user": "tsx scripts/promote-user-role.ts",
    "infra:check": "tsx scripts/check-infra.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.100.14",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.40.0",
    "ioredis": "^5.11.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "recharts": "^2.15.4",
    "sanitize-html": "^2.17.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
